# FVM — la versione di Flutter e' un dato del repository (ADR-A02).
# .fvmrc SI committa (dichiara la versione); .fvm/ NO (e' un symlink alla cache locale).
.fvm/
!.fvmrc

# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
.metadata
*.iml
*.ipr
*.iws

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# Android
android/.gradle/
android/local.properties
android/key.properties
android/app/*.jks
android/app/*.keystore
**/android/**/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/Flutter/flutter_export_environment.sh
**/ios/**/*.mode1v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/xcuserdata/

# Web / Windows / macOS / Linux build targets
web/build/
windows/flutter/ephemeral/
macos/Flutter/ephemeral/
linux/flutter/ephemeral/

# Editor
.idea/
.zed/

# 🚨 Di `.vscode/` si ignora il CONTENUTO, non la cartella, e la differenza
# non e' un cavillo: git non entra in una directory esclusa, quindi un
# `!.vscode/settings.json` dopo un `.vscode/` non verrebbe mai valutato — la
# riga sembrerebbe funzionare e non farebbe niente.
#
# `settings.json` si committa perche' **quale Flutter usa questo repository e'
# un dato del repository**, esattamente come `.fvmrc` (ADR-A02). Senza,
# ogni macchina riparte dal Flutter globale e `pub get` fallisce con
# «The current Dart SDK version is 3.6.0» — un messaggio che non nomina la
# causa vera.
.vscode/*
!.vscode/settings.json

# Segreti e config locale
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db
desktop.ini

# Log di `flutter run` lanciato in background
run.log
run.err

# Cartella di lavoro del compilatore Kotlin (build, non sorgente)
android/.kotlin/
